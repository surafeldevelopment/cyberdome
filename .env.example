# CyberDome Command Center configuration. Copy to .env and edit. Never commit .env.

# --- Server (defaults are safe for local use) ---
# CYBERDOME_HOST=127.0.0.1          # keep loopback: the app has no login
# CYBERDOME_PORT=4646
# CYBERDOME_DATA_DIR=./data         # database + evidence storage
# CYBERDOME_MAX_UPLOAD_MB=50

# --- AI provider (optional). Leave unset to run without AI (truthful "not configured" state). ---
# AI_PROVIDER=anthropic             # anthropic | openai
# CYBERDOME_ANTHROPIC_API_KEY=
# CYBERDOME_ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI or any OpenAI-compatible server (e.g. a local Ollama at http://localhost:11434/v1)
# AI_PROVIDER=openai
# CYBERDOME_OPENAI_API_KEY=
# CYBERDOME_OPENAI_BASE_URL=https://api.openai.com/v1
# CYBERDOME_OPENAI_MODEL=gpt-4o-mini
# CYBERDOME_AI_MAX_TOKENS=2000

# --- External reference data (NVD, CISA KEV, MITRE ATT&CK) ---
# CYBERDOME_REFERENCES_ONLINE=true  # set false to disable all outbound lookups
# NVD_API_KEY=                      # optional; raises NVD rate limits

# --- Optional packet processing ---
# CYBERDOME_TSHARK_PATH=tshark
