{
  "name": "cyberdome-command-center",
  "version": "1.2.2",
  "private": true,
  "description": "CyberDome Command Center - evidence-driven ethical hacking assessment workspace (NWIT 246)",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "backup": "tsx server/scripts/backup.ts",
    "restore": "tsx server/scripts/restore.ts",
    "desktop:build": "npm --prefix desktop install && npm --prefix desktop run build",
    "installer": "npm run desktop:build",
    "release": "node desktop/release.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "fast-xml-parser": "^4.5.7",
    "multer": "^2.4.0",
    "papaparse": "^5.7.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "@types/archiver": "^6.0.4",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
